DJANGO_SECRET_KEY=Key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,s4e.ai,www.s4e.ai
DJANGO_SUBPATH=/loop

DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Loop <noreply@loop.mintaka.arch.jhu.edu>
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0

DEV_COLLECTSTATIC=0

# Optional GSAS-II integration for XRD peak finding.
# Point GSAS2_PATH at the GSAS-II checkout root (the folder that contains GSASII/).
# If you already have a working instrument parameter file, set GSAS2_INSTPRM_PATH too.
GSAS2_PATH=/path/to/GSAS-II
# GSAS2_INSTPRM_PATH=/path/to/GSAS-II/GSASII/inputs/CuKa.instprm

# Optional: AI discretization of batch synthesis routes (OpenRouter).
# Batch uploads store the free-form "Synthesis route" as a single "other" step
# and enqueue a background job; when enabled the worker calls an LLM to split it
# into the typed steps a manual upload produces. Any failure falls back to the
# single "other" step. Leave SYNTHESIS_LLM_ENABLED/WORKER at 0 to ship dark.
SYNTHESIS_LLM_ENABLED=1
SYNTHESIS_LLM_WORKER=1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# SYNTHESIS_LLM_TIMEOUT=60
# SYNTHESIS_LLM_POLL_SECONDS=15
# SYNTHESIS_LLM_MAX_ATTEMPTS=3

# Optional ChemScreen batch-artifact sync. Mount/clone
# https://github.com/entropy4energy/ChemScreen and run:
# python manage.py import_chemscreen --root "$CHEMSCREEN_ROOT" \
#   --predictions "$CHEMSCREEN_PREDICTIONS_PATH"
CHEMSCREEN_ROOT=/app/vendor/ChemScreen
CHEMSCREEN_BOOTSTRAP_ON_START=1
CHEMSCREEN_PREDICTIONS_PATH=
CHEMSCREEN_PREDICTION_METRIC=ML_Predicted
CHEMSCREEN_MODEL_NAME=ChemScreen
CHEMSCREEN_MODEL_DIR=/app/var/chemscreen-models
CHEMSCREEN_AUTOTRAIN_ENABLED=1
CHEMSCREEN_RETRAIN_WORKER=1
# CHEMSCREEN_RETRAIN_POLL_SECONDS=15
# CHEMSCREEN_RETRAIN_DEBOUNCE_SECONDS=15
# CHEMSCREEN_MIN_TRAINING_ROWS=20
# CHEMSCREEN_EFA_REWARD_TOLERANCE=5
# CHEMSCREEN_DEED_REWARD_TOLERANCE=2

# Public AFLOW/AFLUX enrichment. AFLOW supplies formation/entropy features;
# the retrained ChemScreen-style models produce EFA and DEED predictions.
AFLOW_API_ENABLED=1
AFLOW_API_BASE_URL=https://aflow.org/API/aflux/
# AFLOW_API_TIMEOUT=12
# AFLOW_CACHE_HOURS=168

# Paths for file-based data storage.
LOOP_DATA_ROOT=/path/to/loop-data
SQLITE_PATH=/path/to/loop-data/db.sqlite3

# Mongo connections. MONGODB_RAW_URI defaults to the same host with the
# database swapped to /loop_raw, so Docker users only need the first.
# MONGODB_URI=mongodb://localhost:27017/loop
# MONGODB_RAW_URI=mongodb://localhost:27017/loop_raw

# MEDIA_ROOT=/path/to/loop-data/media
# STATIC_ROOT=/path/to/loop-data/staticfiles
# RAW_UPLOADS_ROOT=/path/to/loop-data/raw-uploads   (empty disables the
#                                                    timestamped upload archive)

# --- JSON archive -----------------------------------------------------------
# The catalog's source of truth. Every write lands here as plain JSON before it
# reaches MongoDB, which is treated as a rebuildable index. Back this directory
# up; `manage.py loop_archive rebuild` restores the database from it.
ARCHIVE_ROOT=/path/to/loop-data/archive
# ARCHIVE_ENABLED=1    set 0 to disable archive writes entirely (tests only)
# ARCHIVE_REQUIRED=1   1 = a failed archive write aborts the request and Mongo
#                      is never touched. Set 0 only to keep uploads flowing
#                      through a disk incident; failures are then recorded in
#                      ARCHIVE_ROOT/.state/drift.json for `loop_archive verify`.
# ARCHIVE_FSYNC=1      fsync each record and journal line
