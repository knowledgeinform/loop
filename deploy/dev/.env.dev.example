# Copy to deploy/dev/.env.dev and fill in. Not committed: this file holds the
# secret key and the deployment's real hostnames.
#
# Generate a key: python -c "import secrets; print(secrets.token_urlsafe(50))"
DEV_SECRET_KEY=

# Public hostname served through the Cloudflare tunnel, e.g. dev.example.org.
# Used for ALLOWED_HOSTS, the Access policy, and the printed URLs.
DEV_HOSTNAME=

# Optional: full URL of a companion service to link from the landing page.
# Left blank, that card is hidden rather than rendered as a dead link.
DEV_CHAOS_URL=

# Dev serves a clone of production, real superuser password hashes included.
# 1 (the default in serve.sh) removes /admin/ and the whole /accounts/signup/
# flow from the URL conf -- 404, no form to attack. Set to 0 only for a
# deliberate debugging session, and put it back afterwards.
DEV_LOCKDOWN=1

DEV_WEB_PORT=8011
DEV_MONGO_PORT=27019
DEV_LANDING_PORT=8081
